rules_version = '2';

// Phase 1 baseline: path-based, per-user access.
//
// Items live at users/{uid}/items/{itemId} and carry NO uid field, so rules
// match on the {uid} PATH wildcard, not a document field. The hardening pass
// (field validation, item-cap enforcement) is Phase 5 — keep this minimal.
// See CLAUDE.md "Ship baseline Firestore security rules with the first write".
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
