# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# Extension identity (Phase 0 step 2) — from the pinned manifest key / extension.pem.
WXT_PUBLIC_EXTENSION_ID=
WXT_PUBLIC_OAUTH_REDIRECT_URI=

# Firebase web config (Phase 0 step 5).
# Firebase console > Project settings > General > Your apps > SDK setup and configuration.
# Not secret — it ships in the client bundle.
WXT_PUBLIC_FIREBASE_API_KEY=
WXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
WXT_PUBLIC_FIREBASE_PROJECT_ID=
WXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
WXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
WXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the client at the local Firebase Emulator Suite (Phase 0 step 8).
WXT_PUBLIC_USE_EMULATORS=false
